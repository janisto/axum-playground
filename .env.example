## Core runtime configuration.
# Cloud Run injects PORT automatically. Keep the default for local development.
PORT=8080
FIREBASE_PROJECT_ID=demo-test-project
# Allowed values: development, test, production.
APP_ENVIRONMENT=development

# Optional for future production access. Local emulators need no Google credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# Development/test only. Must use loopback and omit the protocol prefix.
# Configure both hosts with one matching demo-* project. Matches firebase.json.
# Clear both emulator hosts for future production access.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:7110

# Development/test only. Must use loopback and omit the protocol prefix.
# Matches firebase.json.
FIRESTORE_EMULATOR_HOST=127.0.0.1:7130

# Optional Google Cloud project fallbacks for Firestore.
# In emulator mode, leave unset or resolve to the same demo-* Firebase project.
GOOGLE_CLOUD_PROJECT=
GCP_PROJECT=
GCLOUD_PROJECT=
PROJECT_ID=
